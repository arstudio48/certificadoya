# Security Headers
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-XSS-Protection: 1; mode=block

# HSTS (GitHub Pages ya sirve HTTPS, pero reforzamos)
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# Cache Control - HTML pages (5 min cache, 10 min stale-while-revalidate)
/*.html
  Cache-Control: public, max-age=300, stale-while-revalidate=600

# Cache Control - CSS/JS (1 year, immutable with version)
/css/*
  Cache-Control: public, max-age=31536000, immutable
/js/*
  Cache-Control: public, max-age=31536000, immutable

# Cache Control - Images (1 year)
/img/*
  Cache-Control: public, max-age=31536000, immutable

# Cache Control - Fonts (1 year)
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# No cache for API/admin
/supabase/*
  Cache-Control: no-store, must-revalidate
/admin/*
  Cache-Control: no-store, must-revalidate
